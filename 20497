            <div class="fg"><label class="fl">Förderschwerpunkte</label><textarea id="fFocus" class="ft" rows="2"></textarea></div>
            <div class="fg"><label class="fl">Notizen</label><textarea id="fNotes" class="ft" rows="2"></textarea></div>
        </div>
        <div class="mf"><button class="btn btn-s" onclick="cm('moFunder')">Abbrechen</button><button class="btn btn-p" onclick="saveFunder()">Speichern</button></div>
    </div>
</div>

<!-- Project -->
<div class="mo" id="moProject">
    <div class="modal">
        <div class="mh"><h2 class="mt" id="moProjectT">Neues Projekt</h2><button class="mc" onclick="cm('moProject')">✕</button></div>
        <div class="mb">
            <div class="fg"><label class="fl">Projektname *</label><input id="pName" class="fi"></div>
            <div class="fgrid">
                <div class="fg"><label class="fl">Land / Region</label><input id="pRegion" class="fi"></div>
