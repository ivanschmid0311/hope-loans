    </div>
</div>

<!-- Text Block -->
<div class="mo" id="moTb">
    <div class="modal">
        <div class="mh"><h2 class="mt" id="moTbT">Neuer Textbaustein</h2><button class="mc" onclick="cm('moTb')">✕</button></div>
        <div class="mb">
            <div class="fg"><label class="fl">Titel *</label><input id="tbTitle" class="fi" placeholder="z.B. Vereinsbeschreibung"></div>
            <div class="fg"><label class="fl">Kategorie</label>
                <select id="tbCat" class="fs"><option>Allgemein</option><option>Verein</option><option>Projekt</option><option>Budget</option><option>Wirkung</option><option>Referenzen</option></select></div>
            <div class="fg"><label class="fl">Text *</label><textarea id="tbContent" class="ft" rows="8"></textarea></div>
        </div>
        <div class="mf"><button class="btn btn-s" onclick="cm('moTb')">Abbrechen</button><button class="btn btn-p" onclick="saveTb()">Speichern</button></div>
    </div>
</div>

<!-- Task -->
<div class="mo" id="moTask">
    <div class="modal">
        <div class="mh"><h2 class="mt" id="moTaskT">Neue Aufgabe</h2><button class="mc" onclick="cm('moTask')">✕</button></div>
        <div class="mb">
            <div class="fg"><label class="fl">Aufgabe *</label><input id="tTitle" class="fi"></div>
            <div class="fgrid">
                <div class="fg"><label class="fl">Fällig am</label><input type="date" id="tDue" class="fi"></div>
                <div class="fg"><label class="fl">Antrag</label><select id="tApp" class="fs"></select></div>
            </div>
            <div class="fg"><label class="fl">Notizen</label><textarea id="tNotes" class="ft" rows="2"></textarea></div>
        </div>
        <div class="mf"><button class="btn btn-s" onclick="cm('moTask')">Abbrechen</button><button class="btn btn-p" onclick="saveTask()">Speichern</button></div>
    </div>
</div>

<!-- Document -->
<div class="mo" id="moDoc">
    <div class="modal">
        <div class="mh"><h2 class="mt">Dokument hinzufügen</h2><button class="mc" onclick="cm('moDoc')">✕</button></div>
        <div class="mb">
            <div class="fg"><label class="fl">Name *</label><input id="dName" class="fi"></div>
            <div class="fgrid">
                <div class="fg"><label class="fl">Kategorie</label>
                    <select id="dCat" class="fs"><option>Antrag</option><option>Budget</option><option>Bericht</option><option>Korrespondenz</option><option>Sonstiges</option></select></div>
                <div class="fg"><label class="fl">Antrag</label><select id="dApp" class="fs"></select></div>
            </div>
            <div class="fg"><label class="fl">URL / Link</label><input id="dUrl" class="fi" placeholder="https://..."></div>
            <div class="fg"><label class="fl">Notizen</label><textarea id="dNotes" class="ft" rows="2"></textarea></div>
