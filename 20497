            <div class="fg"><label class="fl">Notizen (intern)</label><textarea id="aNotes" class="ft" rows="2"></textarea></div>
        </div>
        <div class="mf"><button class="btn btn-s" onclick="cm('moApp')">Abbrechen</button><button class="btn btn-p" onclick="saveApp()">Speichern</button></div>
    </div>
</div>

<!-- Funder -->
<div class="mo" id="moFunder">
    <div class="modal">
        <div class="mh"><h2 class="mt" id="moFunderT">Neue Stiftung</h2><button class="mc" onclick="cm('moFunder')">✕</button></div>
        <div class="mb">
            <div class="fg"><label class="fl">Name *</label><input id="fName" class="fi"></div>
