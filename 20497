    </div>
</div>

<!-- TB Picker -->
<div class="mo" id="moTbPick">
    <div class="modal">
        <div class="mh"><h2 class="mt">Baustein einfügen</h2><button class="mc" onclick="cm('moTbPick')">✕</button></div>
        <div class="mb">
            <input class="search" id="tbPickSearch" placeholder="Suchen..." oninput="renderTbPick()" style="margin-bottom:12px">
            <div id="tbPickList"></div>
        </div>
    </div>
</div>

<!-- FIREBASE + JS -->
<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import { getFirestore, collection, doc, addDoc, updateDoc, deleteDoc, getDocs, onSnapshot, query, orderBy } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

    const app = initializeApp({
        apiKey: "AIzaSyBLgi8KFBjwiSgAikVFelqfsPVLmglGsXk",
        authDomain: "hope-association-loans.firebaseapp.com",
        projectId: "hope-association-loans",
        storageBucket: "hope-association-loans.firebasestorage.app",
        messagingSenderId: "432884261468",
        appId: "1:432884261468:web:d92185f8bce4f550c17c99"
    });
    const db = getFirestore(app);

    // Data stores
    let applications=[], funders=[], projects=[], textblocks=[], tasks=[], documents=[];
    let editId = null, editType = null;
    let appFilter = 'all', taskFilter = 'open';

    // Status badge helper
    const badgeClass = s => ({
        'Entwurf':'b-draft','In Review':'b-review','Eingereicht':'b-submitted',
        'Bewilligt':'b-approved','Abgelehnt':'b-rejected','Rückfragen':'b-inquiry'
    }[s] || 'b-draft');

    // Navigation
    document.querySelectorAll('.nav-i[data-view]').forEach(el => {
        el.onclick = () => {
            document.querySelectorAll('.nav-i').forEach(n => n.classList.remove('active'));
            el.classList.add('active');
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            document.getElementById('v-' + el.dataset.view).classList.add('active');
        };
    });

    // Tab handlers
    document.getElementById('appTabs').onclick = e => {
        if (!e.target.classList.contains('tab')) return;
        document.querySelectorAll('#appTabs .tab').forEach(t => t.classList.remove('active'));
        e.target.classList.add('active');
        appFilter = e.target.dataset.f;
        renderApps();
    };
    document.getElementById('taskTabs').onclick = e => {
        if (!e.target.classList.contains('tab')) return;
        document.querySelectorAll('#taskTabs .tab').forEach(t => t.classList.remove('active'));
        e.target.classList.add('active');
        taskFilter = e.target.dataset.f;
        renderTasks();
    };

    // Modal helpers
    window.cm = id => document.getElementById(id).classList.remove('active');
    function om(id) { document.getElementById(id).classList.add('active'); }

    // Load all data
    const cols = {
        grant_applications: d => { applications = d; renderApps(); renderDashboard(); populateAppSelects(); },
        grant_funders: d => { funders = d; renderFunders(); populateFunderSelect(); },
        grant_projects: d => { projects = d; renderProjects(); populateProjectSelect(); },
        grant_textblocks: d => { textblocks = d; renderTbs(); },
        grant_tasks: d => { tasks = d; renderTasks(); renderDashboard(); },
        grant_documents: d => { documents = d; renderDocs(); }
    };

    Object.entries(cols).forEach(([col, cb]) => {
        onSnapshot(collection(db, col), snap => {
            cb(snap.docs.map(d => ({ id: d.id, ...d.data() })));
        });
    });

    // RENDER: Dashboard
    function renderDashboard() {
        const s = document.getElementById('statsGrid');
        const counts = { 'Entwurf':0,'In Review':0,'Eingereicht':0,'Bewilligt':0,'Abgelehnt':0,'Rückfragen':0 };
        applications.forEach(a => { if (counts[a.status] !== undefined) counts[a.status]++; });
        s.innerHTML = `
            <div class="stat"><div class="stat-l">Total</div><div class="stat-v">${applications.length}</div></div>
            <div class="stat"><div class="stat-l">Entwurf</div><div class="stat-v" style="color:var(--muted)">${counts['Entwurf']}</div></div>
            <div class="stat"><div class="stat-l">Eingereicht</div><div class="stat-v" style="color:var(--blue)">${counts['Eingereicht']}</div></div>
            <div class="stat"><div class="stat-l">Bewilligt</div><div class="stat-v" style="color:var(--green)">${counts['Bewilligt']}</div></div>
            <div class="stat"><div class="stat-l">Abgelehnt</div><div class="stat-v" style="color:var(--red)">${counts['Abgelehnt']}</div></div>
            <div class="stat"><div class="stat-l">Rückfragen</div><div class="stat-v" style="color:var(--yellow)">${counts['Rückfragen']}</div></div>
        `;
        // Pending badge
        document.getElementById('pendingBadge').textContent = counts['Entwurf'] + counts['In Review'] + counts['Rückfragen'];

        // Deadlines
        const dl = document.getElementById('deadlines');
        const upcoming = applications.filter(a => a.deadline && a.status !== 'Bewilligt' && a.status !== 'Abgelehnt')
            .sort((a,b) => a.deadline.localeCompare(b.deadline)).slice(0, 5);
        if (!upcoming.length) { dl.innerHTML = '<div class="empty"><div class="empty-t">Keine anstehenden Deadlines</div></div>'; }
        else { dl.innerHTML = upcoming.map(a => {
            const days = Math.ceil((new Date(a.deadline) - new Date()) / 86400000);
            const cls = days < 0 ? 'color:var(--red);font-weight:600' : days < 7 ? 'color:var(--yellow);font-weight:600' : '';
            return `<div class="card" style="display:flex;justify-content:space-between;align-items:center;cursor:pointer" onclick="viewApp('${a.id}')">
                <div><strong>${a.title}</strong><div style="font-size:12px;color:var(--muted)">${getProjectName(a.project_id)} → ${getFunderName(a.funder_id)}</div></div>
                <div style="text-align:right"><div style="${cls};font-size:13px">${a.deadline}</div><div style="font-size:11px;color:var(--muted)">${days < 0 ? Math.abs(days)+' Tage überfällig' : days+' Tage'}</div></div>
            </div>`;
        }).join(''); }

        // Recent
        const rc = document.getElementById('recentApps');
        const recent = [...applications].sort((a,b) => (b.updated_at||b.created_at||'').localeCompare(a.updated_at||a.created_at||'')).slice(0,5);
        if (!recent.length) { rc.innerHTML = '<div class="empty"><div class="empty-ic">📋</div><div class="empty-t">Noch keine Anträge</div><button class="btn btn-p" onclick="openApp()">Ersten Antrag erstellen</button></div>'; }
        else { rc.innerHTML = recent.map(a => appCard(a)).join(''); }
    }

    function appCard(a) {
        return `<div class="card" style="cursor:pointer;display:flex;justify-content:space-between;align-items:center" onclick="viewApp('${a.id}')">
            <div>
                <div style="display:flex;align-items:center;gap:8px"><strong style="font-size:14px">${a.title}</strong><span class="badge ${badgeClass(a.status)}">${a.status}</span></div>
                <div style="font-size:12px;color:var(--muted);margin-top:2px">${getProjectName(a.project_id)} → ${getFunderName(a.funder_id)}${a.amount ? ' · CHF '+Number(a.amount).toLocaleString() : ''}</div>
            </div>
            <div style="text-align:right;font-size:12px;color:var(--muted)">${a.deadline||''}</div>
        </div>`;
    }

    // RENDER: Applications
    function renderApps() {
        const search = (document.getElementById('appSearch')?.value || '').toLowerCase();
        let filtered = applications;
        if (appFilter !== 'all') filtered = filtered.filter(a => a.status === appFilter);
        if (search) filtered = filtered.filter(a => (a.title||'').toLowerCase().includes(search) || (getProjectName(a.project_id)).toLowerCase().includes(search) || (getFunderName(a.funder_id)).toLowerCase().includes(search));
        filtered.sort((a,b) => (b.created_at||'').localeCompare(a.created_at||''));
        const el = document.getElementById('appsList');
        if (!filtered.length) { el.innerHTML = '<div class="empty"><div class="empty-ic">📋</div><div class="empty-t">Keine Anträge gefunden</div></div>'; return; }
        el.innerHTML = filtered.map(a => appCard(a)).join('');
    }
    window.renderApps = renderApps;

    // View single application
    window.viewApp = id => {
        const a = applications.find(x => x.id === id);
        if (!a) return;
        document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
        const v = document.getElementById('v-applications');
        // Build detail view inline
        const appTasks = tasks.filter(t => t.application_id === id);
        const appDocs = documents.filter(d => d.application_id === id);
        
        const el = document.getElementById('appsList');
        el.innerHTML = `
            <div style="margin-bottom:16px"><button class="btn btn-s btn-sm" onclick="backToApps()">← Zurück</button></div>
            <div class="card" style="padding:24px">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px">
                    <div>
                        <h2 style="font-family:'DM Serif Display',serif;font-size:22px">${a.title}</h2>
                        <div style="font-size:13px;color:var(--muted);margin-top:4px">${getProjectName(a.project_id)} → ${getFunderName(a.funder_id)}</div>
                    </div>
                    <div style="display:flex;gap:6px;align-items:center">
                        <span class="badge ${badgeClass(a.status)}">${a.status}</span>
                        <button class="btn btn-s btn-sm" onclick="openApp('${a.id}')">✏️ Bearbeiten</button>
                        <button class="btn btn-sm" style="background:var(--red);color:#fff" onclick="deleteApp('${a.id}')">🗑️</button>
                    </div>
                </div>
                ${a.amount ? `<div style="font-size:14px;margin-bottom:8px"><strong>Betrag:</strong> CHF ${Number(a.amount).toLocaleString()}</div>` : ''}
                ${a.deadline ? `<div style="font-size:14px;margin-bottom:8px"><strong>Deadline:</strong> ${a.deadline}</div>` : ''}
                ${a.description ? `<div style="margin-bottom:12px"><strong style="font-size:13px">Beschreibung:</strong><p style="font-size:13px;color:var(--muted);margin-top:4px">${a.description}</p></div>` : ''}
                ${a.content ? `<div style="margin-bottom:12px"><strong style="font-size:13px">Antragstext:</strong><div style="font-size:13px;margin-top:4px;white-space:pre-wrap;background:var(--surface-alt);padding:14px;border-radius:8px;border:1px solid var(--border)">${a.content}</div></div>` : ''}
                ${a.notes ? `<div style="margin-bottom:12px"><strong style="font-size:13px">Notizen:</strong><p style="font-size:13px;color:var(--muted);margin-top:4px;font-style:italic">${a.notes}</p></div>` : ''}
                
                <div style="margin-top:16px;border-top:1px solid var(--border);padding-top:14px">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                        <strong style="font-size:13px">Aufgaben (${appTasks.length})</strong>
                        <button class="btn btn-s btn-sm" onclick="openTask('${a.id}')">+ Aufgabe</button>
                    </div>
                    ${appTasks.length ? appTasks.map(t => `<div class="task ${t.done?'done':''}">
                        <div class="task-cb ${t.done?'done':''}" onclick="toggleTask('${t.id}')">${t.done?'✓':''}</div>
                        <span class="task-t" style="font-size:13px">${t.title}</span>
                        ${t.due ? `<span class="task-due">${t.due}</span>` : ''}
                    </div>`).join('') : '<div style="font-size:12px;color:var(--muted);padding:8px">Keine Aufgaben</div>'}
                </div>
                
                <div style="margin-top:14px;border-top:1px solid var(--border);padding-top:14px">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                        <strong style="font-size:13px">Dokumente (${appDocs.length})</strong>
                        <button class="btn btn-s btn-sm" onclick="openDoc('${a.id}')">+ Dokument</button>
                    </div>
                    ${appDocs.length ? appDocs.map(d => `<div class="file">
                        <span class="file-ic">${d.category==='Budget'?'📊':d.category==='Bericht'?'📄':'📎'}</span>
                        <div><div class="file-n">${d.name}</div><div class="file-m">${d.category}${d.url?' · <a href="'+d.url+'" target="_blank" style="color:var(--accent)">Link öffnen</a>':''}</div></div>
                        <button class="btn btn-sm" style="margin-left:auto;color:var(--red);background:none;border:none" onclick="deleteDoc('${d.id}')">🗑️</button>
                    </div>`).join('') : '<div style="font-size:12px;color:var(--muted);padding:8px">Keine Dokumente</div>'}
                </div>
            </div>`;
        v.classList.add('active');
    };

    window.backToApps = () => renderApps();

    // RENDER: Funders
    function renderFunders() {
        const el = document.getElementById('fundersList');
        if (!funders.length) { el.innerHTML = '<div class="empty"><div class="empty-ic">🏛️</div><div class="empty-t">Noch keine Stiftungen</div><button class="btn btn-p" onclick="openFunder()">Erste Stiftung anlegen</button></div>'; return; }
        el.innerHTML = funders.sort((a,b)=>(a.name||'').localeCompare(b.name||'')).map(f => `<div class="card" style="display:flex;justify-content:space-between;align-items:center">
            <div><strong>${f.name}</strong>${f.contact ? '<span style="font-size:12px;color:var(--muted)"> · '+f.contact+'</span>' : ''}
            ${f.focus ? '<div style="font-size:12px;color:var(--muted);margin-top:2px">'+f.focus+'</div>' : ''}</div>
            <div style="display:flex;gap:4px">
                ${f.website ? '<a href="'+f.website+'" target="_blank" class="btn btn-s btn-sm">🌐</a>' : ''}
                <button class="btn btn-s btn-sm" onclick="openFunder('${f.id}')">✏️</button>
                <button class="btn btn-sm" style="color:var(--red);background:none;border:none" onclick="deleteFunder('${f.id}')">🗑️</button>
            </div>
        </div>`).join('');
    }

    // RENDER: Projects
    function renderProjects() {
        const el = document.getElementById('projectsList');
        if (!projects.length) { el.innerHTML = '<div class="empty"><div class="empty-ic">📁</div><div class="empty-t">Noch keine Projekte</div><button class="btn btn-p" onclick="openProject()">Erstes Projekt anlegen</button></div>'; return; }
        el.innerHTML = projects.sort((a,b)=>(a.name||'').localeCompare(b.name||'')).map(p => {
            const appCount = applications.filter(a => a.project_id === p.id).length;
            return `<div class="card" style="display:flex;justify-content:space-between;align-items:center">
                <div><strong>${p.name}</strong>${p.region ? '<span style="font-size:12px;color:var(--muted)"> · '+p.region+'</span>' : ''}
                ${p.budget ? '<div style="font-size:12px;color:var(--muted)">Budget: CHF '+Number(p.budget).toLocaleString()+'</div>' : ''}
                <div style="font-size:11px;color:var(--accent)">${appCount} Anträge</div></div>
                <div style="display:flex;gap:4px">
                    <button class="btn btn-s btn-sm" onclick="openProject('${p.id}')">✏️</button>
                    <button class="btn btn-sm" style="color:var(--red);background:none;border:none" onclick="deleteProject('${p.id}')">🗑️</button>
                </div>
            </div>`;
        }).join('');
    }

    // RENDER: Text Blocks
    function renderTbs() {
        const search = (document.getElementById('tbSearch')?.value || '').toLowerCase();
        let filtered = textblocks;
        if (search) filtered = filtered.filter(t => (t.title||'').toLowerCase().includes(search) || (t.content||'').toLowerCase().includes(search) || (t.category||'').toLowerCase().includes(search));
        const el = document.getElementById('tbList');
        if (!filtered.length) { el.innerHTML = '<div class="empty"><div class="empty-ic">📝</div><div class="empty-t">Keine Textbausteine</div><button class="btn btn-p" onclick="openTb()">Ersten Baustein erstellen</button></div>'; return; }
        el.innerHTML = filtered.map(t => `<div class="card" style="display:flex;justify-content:space-between;align-items:flex-start">
            <div style="flex:1;min-width:0">
                <div style="font-size:10px;color:var(--accent);font-weight:600;margin-bottom:2px">${t.category||'Allgemein'}</div>
                <strong style="font-size:14px">${t.title}</strong>
                <div style="font-size:12px;color:var(--muted);margin-top:4px;white-space:pre-wrap;max-height:60px;overflow:hidden">${(t.content||'').substring(0,200)}${(t.content||'').length>200?'...':''}</div>
            </div>
            <div style="display:flex;gap:4px;flex-shrink:0;margin-left:12px">
                <button class="btn btn-s btn-sm" onclick="openTb('${t.id}')">✏️</button>
                <button class="btn btn-sm" style="color:var(--red);background:none;border:none" onclick="deleteTb('${t.id}')">🗑️</button>
            </div>
        </div>`).join('');
    }
    window.renderTbs = renderTbs;

    // RENDER: Tasks
    function renderTasks() {
        let filtered = tasks;
        if (taskFilter === 'open') filtered = filtered.filter(t => !t.done);
        else if (taskFilter === 'done') filtered = filtered.filter(t => t.done);
        filtered.sort((a,b) => { if (a.done !== b.done) return a.done ? 1 : -1; return (a.due||'z').localeCompare(b.due||'z'); });
        const el = document.getElementById('tasksList');
        if (!filtered.length) { el.innerHTML = '<div class="empty"><div class="empty-ic">✅</div><div class="empty-t">Keine Aufgaben</div></div>'; return; }
        const today = new Date().toISOString().split('T')[0];
        el.innerHTML = '<div class="card" style="padding:0">' + filtered.map(t => {
            const overdue = t.due && t.due < today && !t.done;
            const appName = t.application_id ? applications.find(a=>a.id===t.application_id)?.title : '';
            return `<div class="task ${t.done?'done':''}">
                <div class="task-cb ${t.done?'done':''}" onclick="toggleTask('${t.id}')">${t.done?'✓':''}</div>
                <div style="flex:1;min-width:0">
                    <span class="task-t" style="font-size:13px">${t.title}</span>
                    ${appName ? '<div style="font-size:11px;color:var(--muted)">📋 '+appName+'</div>' : ''}
                </div>
                ${t.due ? `<span class="task-due ${overdue?'overdue':''}">${t.due}</span>` : ''}
                <button class="btn btn-sm" style="color:var(--red);background:none;border:none;padding:4px" onclick="deleteTask('${t.id}')">🗑️</button>
            </div>`;
        }).join('') + '</div>';
    }

    // RENDER: Documents
    function renderDocs() {
        const el = document.getElementById('docsList');
        if (!documents.length) { el.innerHTML = '<div class="empty"><div class="empty-ic">📎</div><div class="empty-t">Keine Dokumente</div></div>'; return; }
        el.innerHTML = documents.map(d => {
            const appName = d.application_id ? applications.find(a=>a.id===d.application_id)?.title : '';
            return `<div class="file">
                <span class="file-ic">${d.category==='Budget'?'📊':d.category==='Bericht'?'📄':d.category==='Korrespondenz'?'✉️':'📎'}</span>
                <div style="flex:1"><div class="file-n">${d.name}</div><div class="file-m">${d.category||''}${appName?' · 📋 '+appName:''}${d.url?' · <a href="'+d.url+'" target="_blank" style="color:var(--accent)">Öffnen</a>':''}</div></div>
                <button class="btn btn-sm" style="color:var(--red);background:none;border:none" onclick="deleteDoc('${d.id}')">🗑️</button>
            </div>`;
        }).join('');
    }

    // TB Picker for inserting into application
    function renderTbPick() {
        const search = (document.getElementById('tbPickSearch')?.value || '').toLowerCase();
        let filtered = textblocks;
        if (search) filtered = filtered.filter(t => (t.title||'').toLowerCase().includes(search) || (t.category||'').toLowerCase().includes(search));
        document.getElementById('tbPickList').innerHTML = filtered.length ? filtered.map(t => `<div class="tb" onclick="insertTb('${t.id}')">
            <div class="tb-cat">${t.category||'Allgemein'}</div>
            <div class="tb-t">${t.title}</div>
            <div class="tb-p">${(t.content||'').substring(0,120)}...</div>
        </div>`).join('') : '<div style="color:var(--muted);font-size:13px;padding:12px">Keine Bausteine gefunden</div>';
    }
    window.renderTbPick = renderTbPick;

    window.insertTb = id => {
        const tb = textblocks.find(t => t.id === id);
        if (!tb) return;
        const ta = document.getElementById('aContent');
        const pos = ta.selectionStart || ta.value.length;
        const before = ta.value.substring(0, pos);
        const after = ta.value.substring(pos);
        ta.value = before + (before && !before.endsWith('\n') ? '\n\n' : '') + tb.content + (after && !after.startsWith('\n') ? '\n\n' : '') + after;
        cm('moTbPick');
        ta.focus();
    };

    // Populate selects
    function populateProjectSelect() {
        const opts = '<option value="">Projekt wählen...</option>' + projects.map(p => `<option value="${p.id}">${p.name}</option>`).join('');
        document.getElementById('aProject').innerHTML = opts;
    }
    function populateFunderSelect() {
        const opts = '<option value="">Stiftung wählen...</option>' + funders.map(f => `<option value="${f.id}">${f.name}</option>`).join('');
        document.getElementById('aFunder').innerHTML = opts;
    }
    function populateAppSelects() {
        const opts = '<option value="">Keiner</option>' + applications.map(a => `<option value="${a.id}">${a.title}</option>`).join('');
        ['tApp','dApp'].forEach(id => { const el = document.getElementById(id); if (el) el.innerHTML = opts; });
    }

    // Helpers
    function getProjectName(id) { return projects.find(p => p.id === id)?.name || '–'; }
    function getFunderName(id) { return funders.find(f => f.id === id)?.name || '–'; }

    // OPEN modals
    window.openApp = (id) => {
        editId = id || null; editType = 'app';
        document.getElementById('moAppT').textContent = id ? 'Antrag bearbeiten' : 'Neuer Antrag';
        if (id) {
            const a = applications.find(x => x.id === id);
            if (!a) return;
            document.getElementById('aProject').value = a.project_id || '';
            document.getElementById('aFunder').value = a.funder_id || '';
            document.getElementById('aTitle').value = a.title || '';
            document.getElementById('aAmount').value = a.amount || '';
            document.getElementById('aDeadline').value = a.deadline || '';
            document.getElementById('aStatus').value = a.status || 'Entwurf';
            document.getElementById('aDesc').value = a.description || '';
            document.getElementById('aContent').value = a.content || '';
            document.getElementById('aNotes').value = a.notes || '';
        } else {
            ['aTitle','aAmount','aDeadline','aDesc','aContent','aNotes'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('aStatus').value = 'Entwurf';
        }
        om('moApp');
    };

    window.openFunder = (id) => {
        editId = id || null;
        document.getElementById('moFunderT').textContent = id ? 'Stiftung bearbeiten' : 'Neue Stiftung';
        if (id) {
            const f = funders.find(x => x.id === id);
            document.getElementById('fName').value = f?.name || '';
            document.getElementById('fContact').value = f?.contact || '';
            document.getElementById('fEmail').value = f?.email || '';
            document.getElementById('fWeb').value = f?.website || '';
            document.getElementById('fFocus').value = f?.focus || '';
            document.getElementById('fNotes').value = f?.notes || '';
        } else { ['fName','fContact','fEmail','fWeb','fFocus','fNotes'].forEach(id => document.getElementById(id).value = ''); }
        om('moFunder');
    };

    window.openProject = (id) => {
        editId = id || null;
        document.getElementById('moProjectT').textContent = id ? 'Projekt bearbeiten' : 'Neues Projekt';
        if (id) {
            const p = projects.find(x => x.id === id);
            document.getElementById('pName').value = p?.name || '';
            document.getElementById('pRegion').value = p?.region || '';
            document.getElementById('pBudget').value = p?.budget || '';
            document.getElementById('pDesc').value = p?.description || '';
        } else { ['pName','pRegion','pBudget','pDesc'].forEach(id => document.getElementById(id).value = ''); }
        om('moProject');
    };

    window.openTb = (id) => {
        editId = id || null;
        document.getElementById('moTbT').textContent = id ? 'Baustein bearbeiten' : 'Neuer Textbaustein';
        if (id) {
            const t = textblocks.find(x => x.id === id);
            document.getElementById('tbTitle').value = t?.title || '';
            document.getElementById('tbCat').value = t?.category || 'Allgemein';
            document.getElementById('tbContent').value = t?.content || '';
        } else { ['tbTitle','tbContent'].forEach(id => document.getElementById(id).value = ''); document.getElementById('tbCat').value = 'Allgemein'; }
        om('moTb');
    };

    window.openTask = (appId) => {
        editId = null;
        ['tTitle','tDue','tNotes'].forEach(id => document.getElementById(id).value = '');
        if (appId) document.getElementById('tApp').value = appId;
        om('moTask');
    };

    window.openDoc = (appId) => {
        ['dName','dUrl','dNotes'].forEach(id => document.getElementById(id).value = '');
        if (appId) document.getElementById('dApp').value = appId;
        om('moDoc');
    };

    window.openTbPicker = () => { renderTbPick(); om('moTbPick'); };

    // SAVE functions
    window.saveApp = async () => {
        const title = document.getElementById('aTitle').value.trim();
        if (!title) { alert('Titel erforderlich'); return; }
        const data = {
            project_id: document.getElementById('aProject').value,
            funder_id: document.getElementById('aFunder').value,
            title, amount: parseFloat(document.getElementById('aAmount').value) || null,
            deadline: document.getElementById('aDeadline').value,
            status: document.getElementById('aStatus').value,
            description: document.getElementById('aDesc').value.trim(),
            content: document.getElementById('aContent').value,
            notes: document.getElementById('aNotes').value.trim(),
            updated_at: new Date().toISOString()
        };
        if (editId) { await updateDoc(doc(db,'grant_applications',editId), data); }
        else { data.created_at = new Date().toISOString(); await addDoc(collection(db,'grant_applications'), data); }
        cm('moApp');
    };

    window.saveFunder = async () => {
        const name = document.getElementById('fName').value.trim();
        if (!name) { alert('Name erforderlich'); return; }
        const data = { name, contact: document.getElementById('fContact').value.trim(), email: document.getElementById('fEmail').value.trim(), website: document.getElementById('fWeb').value.trim(), focus: document.getElementById('fFocus').value.trim(), notes: document.getElementById('fNotes').value.trim(), updated_at: new Date().toISOString() };
        if (editId) { await updateDoc(doc(db,'grant_funders',editId), data); }
        else { data.created_at = new Date().toISOString(); await addDoc(collection(db,'grant_funders'), data); }
        cm('moFunder');
    };

    window.saveProject = async () => {
        const name = document.getElementById('pName').value.trim();
        if (!name) { alert('Name erforderlich'); return; }
        const data = { name, region: document.getElementById('pRegion').value.trim(), budget: parseFloat(document.getElementById('pBudget').value) || null, description: document.getElementById('pDesc').value.trim(), updated_at: new Date().toISOString() };
        if (editId) { await updateDoc(doc(db,'grant_projects',editId), data); }
        else { data.created_at = new Date().toISOString(); await addDoc(collection(db,'grant_projects'), data); }
        cm('moProject');
    };

    window.saveTb = async () => {
        const title = document.getElementById('tbTitle').value.trim();
        const content = document.getElementById('tbContent').value.trim();
        if (!title || !content) { alert('Titel und Text erforderlich'); return; }
        const data = { title, category: document.getElementById('tbCat').value, content, updated_at: new Date().toISOString() };
        if (editId) { await updateDoc(doc(db,'grant_textblocks',editId), data); }
        else { data.created_at = new Date().toISOString(); await addDoc(collection(db,'grant_textblocks'), data); }
        cm('moTb');
    };

    window.saveTask = async () => {
        const title = document.getElementById('tTitle').value.trim();
        if (!title) { alert('Aufgabe erforderlich'); return; }
        const data = { title, due: document.getElementById('tDue').value, application_id: document.getElementById('tApp').value, notes: document.getElementById('tNotes').value.trim(), done: false, created_at: new Date().toISOString() };
        await addDoc(collection(db,'grant_tasks'), data);
        cm('moTask');
    };

    window.saveDoc = async () => {
        const name = document.getElementById('dName').value.trim();
        if (!name) { alert('Name erforderlich'); return; }
        const data = { name, category: document.getElementById('dCat').value, application_id: document.getElementById('dApp').value, url: document.getElementById('dUrl').value.trim(), notes: document.getElementById('dNotes').value.trim(), created_at: new Date().toISOString() };
        await addDoc(collection(db,'grant_documents'), data);
        cm('moDoc');
    };

    // Toggle task
    window.toggleTask = async (id) => {
        const t = tasks.find(x => x.id === id);
        if (t) await updateDoc(doc(db,'grant_tasks',id), { done: !t.done });
    };

    // DELETE functions
    window.deleteApp = async (id) => { if (confirm('Antrag wirklich löschen?')) { await deleteDoc(doc(db,'grant_applications',id)); renderApps(); } };
    window.deleteFunder = async (id) => { if (confirm('Stiftung löschen?')) await deleteDoc(doc(db,'grant_funders',id)); };
    window.deleteProject = async (id) => { if (confirm('Projekt löschen?')) await deleteDoc(doc(db,'grant_projects',id)); };
    window.deleteTb = async (id) => { if (confirm('Baustein löschen?')) await deleteDoc(doc(db,'grant_textblocks',id)); };
    window.deleteTask = async (id) => { if (confirm('Aufgabe löschen?')) await deleteDoc(doc(db,'grant_tasks',id)); };
    window.deleteDoc = async (id) => { if (confirm('Dokument löschen?')) await deleteDoc(doc(db,'grant_documents',id)); };
</script>
</body>
</html>
