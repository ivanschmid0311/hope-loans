            </div>
            <div class="fg"><label class="fl">Titel *</label><input id="aTitle" class="fi" placeholder="z.B. Schulbau Kathmandu Phase 2"></div>
            <div class="fgrid">
                <div class="fg"><label class="fl">Betrag (CHF)</label><input type="number" id="aAmount" class="fi"></div>
                <div class="fg"><label class="fl">Deadline</label><input type="date" id="aDeadline" class="fi"></div>
            </div>
            <div class="fg"><label class="fl">Status</label>
                <select id="aStatus" class="fs">
                    <option>Entwurf</option><option>In Review</option><option>Eingereicht</option>
                    <option>Rückfragen</option><option>Bewilligt</option><option>Abgelehnt</option>
                </select>
            </div>
            <div class="fg"><label class="fl">Beschreibung</label><textarea id="aDesc" class="ft" rows="2"></textarea></div>
            <div class="fg"><label class="fl">Antragstext</label>
